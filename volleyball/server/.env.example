# Copy to .env and fill in. Never commit the real .env.
# Comma-separated token:owner pairs. Generate tokens with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VB_API_TOKENS=replace-with-a-long-random-token:my-family
# Origins allowed to call the API (where the web app is hosted).
VB_CORS_ORIGINS=https://jessem1975.github.io,http://localhost:8080
VB_MAX_UPLOAD_MB=8000
VB_RETENTION_DAYS=30
